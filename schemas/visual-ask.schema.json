{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davlug3/pcb-design-skill/schemas/visual-ask.schema.json",
  "title": "Visual Ask payload",
  "description": "Questions served by scripts/visual_ask.py. Footprint options can name a KiCad footprint; the server adds a real SVG preview from the footprint geometry.",
  "type": "object",
  "required": ["title", "questions"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "title": {"type": "string", "minLength": 1, "maxLength": 200},
    "intro": {"type": "string", "maxLength": 2000},
    "submit_label": {"type": "string", "minLength": 1, "maxLength": 40, "default": "Send answers"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/question"}
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["id", "type", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "description": "Stable key used in the answer JSON."
        },
        "type": {
          "enum": ["footprint", "choice", "multi", "text", "confirm"]
        },
        "prompt": {"type": "string", "minLength": 1, "maxLength": 500},
        "help": {"type": "string", "maxLength": 1000},
        "required": {"type": "boolean", "description": "Defaults to true except for text questions."},
        "allow_custom": {
          "type": "boolean",
          "default": false,
          "description": "Footprint questions only: allow a typed Library:Footprint ID."
        },
        "custom_label": {"type": "string", "maxLength": 120},
        "custom_placeholder": {"type": "string", "maxLength": 120},
        "placeholder": {"type": "string", "maxLength": 200},
        "min_selections": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40,
          "description": "Multi-choice questions only."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {"$ref": "#/$defs/option"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["footprint", "choice", "multi"]}}},
          "then": {"required": ["options"]}
        }
      ]
    },
    "option": {
      "oneOf": [
        {"type": "string", "description": "Footprint shorthand, e.g. Resistor_SMD:R_0805_2012Metric."},
        {
          "type": "object",
          "anyOf": [{"required": ["id"]}, {"required": ["footprint"]}],
          "additionalProperties": false,
          "properties": {
            "id": {"type": "string", "minLength": 1, "maxLength": 200},
            "label": {"type": "string", "minLength": 1, "maxLength": 200},
            "description": {"type": "string", "maxLength": 1000},
            "footprint": {
              "type": "string",
              "description": "KiCad Library:Footprint ID or a .kicad_mod path."
            },
            "swatch": {"type": "string", "description": "CSS color for a choice swatch."},
            "image": {
              "type": "string",
              "description": "Optional data:image/... or https URL."
            },
            "preview_svg": {
              "type": "string",
              "description": "Optional pre-rendered SVG. Usually generated by the server."
            },
            "meta": {"type": "object"}
          }
        }
      ]
    }
  }
}
